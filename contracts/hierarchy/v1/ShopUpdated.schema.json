{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopUpdated v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "companyId",
    "entityId",
    "shopId",
    "agencyId",
    "territoryId",
    "changedFields",
    "effectiveAt",
    "correlationId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "ShopUpdated"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "shopId": {
      "type": "string",
      "format": "uuid"
    },
    "agencyId": {
      "type": "string",
      "format": "uuid"
    },
    "territoryId": {
      "type": "string",
      "format": "uuid"
    },
    "changedFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "latitude",
          "longitude",
          "creditLimit",
          "status",
          "address",
          "ownerName",
          "ownerEmail",
          "ownerPhone"
        ]
      }
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}