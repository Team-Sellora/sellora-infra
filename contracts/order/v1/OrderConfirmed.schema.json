{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderConfirmed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "correlationId",
    "occurredAt",
    "orderReference",
    "companyId",
    "shopId",
    "shopName",
    "agencyId",
    "agencyName",
    "territoryId",
    "salesRepId",
    "salesRepName",
    "deliveryType",
    "lines",
    "totalAmount",
    "currency",
    "checkoutLocation"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "OrderConfirmed"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "companyId": {
      "type": "string",
      "format": "uuid"
    },
    "shopId": {
      "type": "string",
      "format": "uuid"
    },
    "shopName": {
      "type": "string"
    },
    "shopEmail": {
      "type": "string",
      "format": "email"
    },
    "agencyId": {
      "type": "string",
      "format": "uuid"
    },
    "agencyName": {
      "type": "string"
    },
    "agencyEmail": {
      "type": "string",
      "format": "email"
    },
    "territoryId": {
      "type": "string",
      "format": "uuid"
    },
    "salesRepId": {
      "type": "string",
      "format": "uuid"
    },
    "salesRepName": {
      "type": "string"
    },
    "deliveryType": {
      "type": "string",
      "enum": ["Delivery", "Pickup"]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "productName", "sku", "quantity", "unitPrice", "lineTotal"],
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "lineTotal": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "checkoutLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMetres": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
