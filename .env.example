# Copy to .env and fill in. .env must be git-ignored.

IS_HOST=https://13.61.228.129:9443

IS_ADMIN_USER=admin
IS_ADMIN_PASS=changeme

# Test client used for CLI token verification only.
# This is NOT the SPA client — the SPA is a public client using PKCE (US-E0-3).
TEST_CLIENT_ID=
TEST_CLIENT_SECRET=

# Application internal UUIDs (NOT client IDs) that configure-apps.sh configures.
# Space-separated. Get them with:
#   curl -sk -u admin:admin "$IS/api/server/v1/applications" \
#     | python3 -c "import sys,json;[print(a['id'],a['name']) for a in json.load(sys.stdin)['applications']]"
APP_IDS="80deb025-f61a-44ae-a3aa-bdf5b0c44754 248db66f-93ac-4566-9b62-0e6885cc440e"

# Password applied to all seeded test users.
SEED_USER_PASSWORD=Test@1234

# Tenant the seeded users belong to.
SEED_COMPANY_ID=COMP-001
